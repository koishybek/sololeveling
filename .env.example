# Copy to .env and fill in. .env is gitignored.
# OpenAI — used for vision (gpt-4o), voice (whisper-1), and text parsing (gpt-4o-mini)
OPENAI_API_KEY=

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup.html
# Falls back to DEMO_KEY (rate-limited) if unset.
USDA_FDC_API_KEY=
