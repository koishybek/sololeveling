# Copy to .env and fill in. .env is gitignored.
# Groq (OpenAI-compatible) — vision, voice (Whisper) and text parsing.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: comma-separated model overrides, tried before the built-in
# fallback chain (see src/lib/ai/client.ts). On a 429 the next model is used.
# AI_VISION_MODEL=qwen/qwen3.8-27b
# AI_TEXT_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup.html
# Falls back to DEMO_KEY (rate-limited) if unset.
USDA_FDC_API_KEY=
